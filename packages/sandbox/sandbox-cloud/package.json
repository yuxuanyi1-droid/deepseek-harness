{
  "name": "@deepseek-ai/dsh-sandbox-cloud",
  "description": "Cloud Agent sandbox provider for DeepSeek Harness: dual execution modes (In-Sandbox Ephemeral Agent default vs Remote Capability Seam Proxy) and E2B, Modal, and Daytona cloud sandboxes",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sandbox/sandbox-cloud"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-sandbox": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:~",
    "@deepseek-ai/dsh-util-values": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-sandbox": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*"
  }
}
